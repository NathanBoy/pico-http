# Normalize line endings across platforms (LF for text files).
* text=auto eol=lf

# Binary / generated files must never be treated as text.
*.map binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# Linguist: the demo is illustrative, not source to be counted.
examples/** linguist-detectable=false
