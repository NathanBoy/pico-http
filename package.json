{
  "name": "pico-http",
  "version": "0.1.0",
  "description": "A tiny, zero-dependency, type-safe HTTP client with a pluggable interceptor pipeline, built on the native fetch API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "http",
    "client",
    "fetch",
    "interceptor",
    "middleware",
    "typescript",
    "typed",
    "http-client"
  ],
  "author": "NathanBoy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NathanBoy/pico-http.git"
  },
  "bugs": {
    "url": "https://github.com/NathanBoy/pico-http/issues"
  },
  "homepage": "https://github.com/NathanBoy/pico-http#readme",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.10",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.8"
  }
}
